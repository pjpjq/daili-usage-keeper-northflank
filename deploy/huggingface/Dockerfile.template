# syntax=docker/dockerfile:1

# This digest is resolved from the latest non-prerelease GitHub release by
# scripts/sync_hf_space.py. Using the digest keeps each deployment immutable.
FROM ghcr.io/willxup/cpa-usage-keeper@__UPSTREAM_IMAGE_DIGEST__

USER root
RUN apk add --no-cache python3 py3-pip \
    && python3 -m pip install --no-cache-dir --break-system-packages huggingface_hub==1.4.1

COPY hf_state_snapshot.py /app/hf_state_snapshot.py
COPY entrypoint.space.sh /usr/local/bin/entrypoint.space.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.space.sh \
    && chmod +x /usr/local/bin/entrypoint.space.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.space.sh"]
CMD ["/app/cpa-usage-keeper"]
